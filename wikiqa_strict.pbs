#!/bin/bash
# 判定プロンプトの比較（既定 vs 厳しい版）。
#
# 既定は 1,000 件中 16 件（1.6%）しか落とさず、「黒田茂助（漆器商）」
# 「実践倫理宏正会研修会館」のような、人が自発的に持ち出すとは考えにくい話題が残った。
# 厳しい版は「対象そのものを人が会話で持ち出すか」を先に判定させる。
#
# **同一の 1,000 件に対して走らせる**（--seed 1 --num_samples 1000 を既定版と揃える）。
# 集合が違うと、採用率の差が判定基準の差なのか標本の差なのか分離できない。
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -N 0374_wikiqa_strict
#PBS -j oe

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/13.0 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"
export VLLM_USE_FLASHINFER_SAMPLER=0 HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_CACHE_ROOT=/tmp/vllm_cache_${USER}_wqs
export TORCHINDUCTOR_CACHE_DIR=/tmp/inductor_${USER}_wqs
export TRITON_CACHE_DIR=/tmp/triton_${USER}_wqs
mkdir -p "$VLLM_CACHE_ROOT" "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"

MODEL=/groups/gcg51557/experiments/0374_japanese_kame/models/llm-jp-4-32b-a3b-thinking
VENV=.venv_vllm; PORT=8101; NAME=llm-jp-4-32b-a3b-thinking
IN=data/japanese_kame/qa_pairs/wiki_candidates.jsonl
OUT=data/japanese_kame/qa_pairs/wiki_qa_strict.jsonl

echo "===== $(date) $(hostname) ====="
git rev-parse --short HEAD; git status --porcelain | wc -l
rm -f "$OUT"   # 比較のため毎回作り直す

$VENV/bin/python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL" --served-model-name "$NAME" \
    --max-model-len 16384 --gpu-memory-utilization 0.90 --enforce-eager \
    --port "$PORT" > vllm_server_wqs.log 2>&1 &
VLLM_PID=$!
trap 'kill "$VLLM_PID" 2>/dev/null || true' EXIT

for i in $(seq 1 150); do
    curl -s -o /dev/null "http://localhost:${PORT}/v1/models" && { echo "vLLM ready ($((i*10))s)"; break; }
    kill -0 "$VLLM_PID" 2>/dev/null || { echo "!! vLLM died"; tail -40 vllm_server_wqs.log; exit 1; }
    sleep 10
done

S=$(date +%s)
$VENV/bin/python scripts/japanese_kame/01c_generate_wiki_qa.py \
    --input_file "$IN" --output_file "$OUT" \
    --num_samples 1000 --seed 1 --workers 32 --effort low --role strict \
    --model "$NAME" --llm_base_url "http://localhost:${PORT}/v1"
E=$(date +%s)

echo "===== 終了 $(date) ====="
echo "経過 $((E-S)) 秒"
echo "--- 採用された例（無作為 12 件）---"
python3 -c "
import json, random
rows=[json.loads(l) for l in open('$OUT',encoding='utf-8') if l.strip()]
for r in random.Random(0).sample(rows, min(12,len(rows))):
    print('  【' + r['title'] + '】' + r['question'] + '  →  ' + r['answer'])
"
