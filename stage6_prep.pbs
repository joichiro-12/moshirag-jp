#!/bin/bash
#PBS -P gcg51557
#PBS -q rt_HC
#PBS -l select=1
#PBS -l walltime=2:00:00
#PBS -N 0374_s6prep
#PBS -j oe
set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
export PATH="$HOME/.local/bin:$PATH"
B=/groups/gcg51557/experiments/0374_japanese_kame
uv run --extra data python tools/prepare_dataset_moshirag.py \
  --tokenized_text_dir  $B/stage5_tokenized_text \
  --tokenized_audio_dir $B/stage5_tokenized_audio \
  --ref_embed_dir       $B/stage5_ref_embed \
  --ret_dir             $B/pilot5k_ret \
  --stems               $B/pilot5k_clean.txt \
  --output_prefix       $B/stage6_dataset/moshirag_jp_pilot
