#!/bin/bash
# Wikipedia 由来 QA から会話を生成する（本番）。
#
#   # QA の 8 シャードを結合してから投げる（02e は --input_file を 1 つだけ受け取る）
#   cat data/japanese_kame/qa_pairs/wiki_qa.s*of008.jsonl > data/japanese_kame/qa_pairs/wiki_qa.jsonl
#   for s in $(seq 0 15); do qsub -P gcg51557 -v SHARD=$s,NSHARD=16 gen_wiki_main.pbs; done
#
# ## 規模
#
# 目標は JaQuAD 由来と合わせて 10 万会話。JaQuAD は 35,687 会話なので、
# Wikipedia からは 64,313 会話を作る。根拠は音声化の処理能力であり、
# 10/10 までに音声化を終えるにはこれ以上は間に合わないと考えている。
# QA は約 19.7 万件あるので、必要になれば NUM を上げるだけで増やせる。
#
# ## JaQuAD 側と揃えている条件
#
# --min_turns 3 --max_turns 5、effort の各設定、--seed 1。
# 揃えないと、JaQuAD 由来と Wikipedia 由来の差が入力の差なのか条件の差なのか分離できない。
#
# 出力は JaQuAD 由来（pilot5k/）と分けて wiki_main/ に置く。stem は wiki_qa_NNNNNN になる。
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=16:00:00
#PBS -N 0374_gen_wiki
#PBS -j oe

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/13.0 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"

SHARD="${SHARD:-0}"; NSHARD="${NSHARD:-1}"; NUM="${NUM:-64313}"
PORT=$((8300 + SHARD))
TAG="gw_s${SHARD}of${NSHARD}"

export VLLM_USE_FLASHINFER_SAMPLER=0 HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_CACHE_ROOT=/tmp/vllm_cache_${USER}_${TAG}
export TORCHINDUCTOR_CACHE_DIR=/tmp/inductor_${USER}_${TAG}
export TRITON_CACHE_DIR=/tmp/triton_${USER}_${TAG}
mkdir -p "$VLLM_CACHE_ROOT" "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"

MODEL=/groups/gcg51557/experiments/0374_japanese_kame/models/llm-jp-4-32b-a3b-thinking
VENV=.venv_vllm; NAME=llm-jp-4-32b-a3b-thinking
SCRIPT=scripts/japanese_kame/02e_generate_moshirag_v5.py
IN=data/japanese_kame/qa_pairs/wiki_qa.jsonl
OUT=data/moshirag_jp/wiki_main

[ -s "$IN" ] || { echo "!! $IN が無い。QA の 8 シャードを結合してから投げる"; exit 1; }

echo "===== $(date) $(hostname) シャード ${SHARD}/${NSHARD} ====="
git rev-parse --short HEAD; git status --porcelain | grep -v '^??' | wc -l
echo "入力 $(wc -l < "$IN") 件から $NUM 件 / 開始時点の完了数: $(ls "$OUT"/*.json 2>/dev/null | wc -l)"
mkdir -p "$OUT"

$VENV/bin/python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL" --served-model-name "$NAME" \
    --max-model-len 16384 --gpu-memory-utilization 0.90 --enforce-eager \
    --port "$PORT" > "vllm_server_${TAG}.log" 2>&1 &
VLLM_PID=$!
trap 'kill "$VLLM_PID" 2>/dev/null || true' EXIT

for i in $(seq 1 150); do
    curl -s -o /dev/null "http://localhost:${PORT}/v1/models" && { echo "vLLM ready ($((i*10))s)"; break; }
    kill -0 "$VLLM_PID" 2>/dev/null || { echo "!! vLLM died"; tail -40 "vllm_server_${TAG}.log"; exit 1; }
    sleep 10
done

S=$(date +%s)
$VENV/bin/python "$SCRIPT" \
    --input_file "$IN" --output_dir "$OUT" --num_samples "$NUM" --seed 1 \
    --shard "$SHARD" --nshard "$NSHARD" \
    --model "$NAME" --llm_base_url "http://localhost:${PORT}/v1" \
    --min_turns 3 --max_turns 5 --workers 32 \
    --effort_human high --effort_assistant low --effort_chunk low \
    --effort_judge low --effort_lead low --resume 2>&1 | tail -20
E=$(date +%s)

echo "===== 終了 $(date) ====="
echo "経過 $((E-S)) 秒 / 全体の完了数 $(ls "$OUT"/*.json 2>/dev/null | wc -l) / $NUM"
