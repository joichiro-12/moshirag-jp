#!/bin/bash
# Throughput calibration for MoshiRAG-JP generation.
# Varies --workers only (vLLM config is held fixed, including --enforce-eager, so that
# a single variable moves). 20 conversations per condition, same --seed so the work is
# identical across conditions.
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=02:00:00
#PBS -N 0374_moshirag_calib
#PBS -j oe

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/13.0 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"
export VLLM_USE_FLASHINFER_SAMPLER=0
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_CACHE_ROOT=/tmp/vllm_cache_$USER
export TORCHINDUCTOR_CACHE_DIR=/tmp/inductor_$USER
export TRITON_CACHE_DIR=/tmp/triton_$USER
mkdir -p "$VLLM_CACHE_ROOT" "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"

MODEL=/groups/gcg51557/experiments/0374_japanese_kame/models/llm-jp-4-32b-a3b-thinking
VENV=.venv_vllm
PORT=8000
NAME=llm-jp-4-32b-a3b-thinking
SCRIPT=moshirag_data/s02_dialogue.py

echo "===== env ====="; date; hostname
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

$VENV/bin/python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL" --served-model-name "$NAME" \
    --max-model-len 16384 --gpu-memory-utilization 0.90 --enforce-eager \
    --port "$PORT" > vllm_server.log 2>&1 &
VLLM_PID=$!
trap 'kill "$VLLM_PID" 2>/dev/null || true' EXIT

for i in $(seq 1 150); do
    curl -s -o /dev/null "http://localhost:${PORT}/v1/models" && { echo "vLLM ready ($((i*10))s)"; break; }
    kill -0 "$VLLM_PID" 2>/dev/null || { echo "!! vLLM died"; cat vllm_server.log; exit 1; }
    sleep 10
done

kv() { curl -s "http://localhost:${PORT}/metrics" 2>/dev/null \
       | grep -E '^vllm:(gpu_cache_usage_perc|num_requests_running)' | tr '\n' ' '; }

for W in 8 32 64; do
    OUT="data/moshirag_jp/calib_w${W}"
    rm -rf "$OUT"
    echo "======================================================================"
    echo "===== workers=${W} ====="
    S=$(date +%s)
    $VENV/bin/python "$SCRIPT" \
        --input_file data/japanese_kame/qa_pairs/jaquad.jsonl \
        --output_dir "$OUT" --num_samples 20 --seed 1 \
        --model "$NAME" --llm_base_url "http://localhost:${PORT}/v1" \
        --min_turns 3 --max_turns 5 --workers "$W" \
        --effort_human high --effort_assistant low --effort_chunk low \
        --effort_judge low --effort_lead low 2>&1 | tail -4
    E=$(date +%s)
    N=$(ls "$OUT"/*.txt 2>/dev/null | wc -l)
    D=$((E-S))
    echo "RESULT workers=${W} elapsed=${D}s files=${N} sec_per_conv=$(awk "BEGIN{printf \"%.1f\", ${D}/(${N}==0?1:${N})}") conv_per_hour=$(awk "BEGIN{printf \"%.0f\", 3600*${N}/${D}}")"
    echo "metrics: $(kv)"
done

echo "===== KV キャッシュ使用率の最大（全期間） ====="
grep -oE 'GPU KV cache usage: [0-9.]+%' vllm_server.log | sort -t' ' -k5 -rn | head -3
date
