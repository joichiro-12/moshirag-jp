#!/bin/bash
#PBS -P gcg51557
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=4:00:00
#PBS -N 0374_sweep
#PBS -j oe
set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
export PATH="$HOME/.local/bin:$PATH"
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/12.6 2>/dev/null || true
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
B=/groups/gcg51557/experiments/0374_japanese_kame

# 更新回数に沿った傾きを取る。目的は 2 つ。
#   ① <ret> の実効出力確率が更新回数とともにどう伸びるか（飽和しているか）
#   ② correct − none の符号反転が bridge の成長と連動しているか
# d3b(1k) と d4 の中間保存（2k/4k/6k/8k）と最終(10k)を同じ条件で測る。
for S in 1000:ckpt_d3b 2000:ckpt_d4_step2000 4000:ckpt_d4_step4000 \
         6000:ckpt_d4_step6000 8000:ckpt_d4_step8000 10000:ckpt_d4; do
  STEP=${S%%:*}; DIR=${S##*:}
  echo "########## ${STEP} ステップ（${DIR}） ##########"
  echo "--- bridge の出力ノルム ---"
  uv run --extra data python moshirag/check_bridge_one.py --bridge $B/$DIR/bridge.safetensors
  echo "--- <ret> の自力出力 ---"
  uv run --extra data python moshirag/eval_ret_emission.py --stems $B/split_eval.txt --n_conv 200 \
    --ckpt $B/$DIR/model.safetensors
  echo "--- リファレンスの寄与（損失） ---"
  uv run --extra data python moshirag/eval_ref_contribution.py --stems $B/split_eval.txt --n_conv 200 \
    --ckpt $B/$DIR/model.safetensors --bridge_ckpt $B/$DIR/bridge.safetensors
done
