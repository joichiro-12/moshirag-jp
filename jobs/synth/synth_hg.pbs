#!/bin/bash
# 音声化の本番（rt_HG・1 GPU）。8 月に 6 本同時で 12 時間走り、管理者に消されなかった構成に揃える。
#
#   for s in 0 1 2 3 4 5; do qsub -v SHARD=$s,NSHARD=6 jobs/synth/synth_hg.pbs; done
#
# 次の回の予約は、シャードごとに「同じシャードの前の回」へ依存させた単発のジョブで入れる。
#
#   qsub -v SHARD=<s>,NSHARD=6 -W depend=afterok:<シャード s の前の回のジョブ番号> jobs/synth/synth_hg.pbs
#
# 前の回が異常終了（killer による削除・walltime 超過）すると、そのシャードの予約は走らずに取り消される。
#
# **アレイジョブ（-J）は使わない。** LLM-jp の決まりで、待機中・実行中を問わず自動で削除される
# （「ABCI 3.0 の使い方 @LLM-jp」2026-08-05 版 p.28。9/27 の 2452850[] は投入 2 分で消された）。
# 大量のジョブは、依存関係でつなぐかスクリプト内のループで処理するのが推奨の方法である（同 p.17）。
# ## 8 月（synth_shard.pbs）との違い
#
# キュー・GPU 数・walltime・ジョブ名・同時本数は 8 月と同じにしている。違いは次の 3 点だけ。
#
#   ① 外部に出ない設定（HF_HUB_OFFLINE と、繋がらない代理サーバ）。8 月は設定漏れで
#      huggingface.co への接続を試みていた。AUDIT_NET=1 で接続の試みをログに残す
#   ② 会話ごとに uv run を起動せず、モデルを 1 回だけ読む worker 方式（tools/synth_worker.py）。
#      モデルを使い回しても出力が変わらないことは synth_verify.pbs で確認済み
#   ③ 起動から 11.5 時間を過ぎたら新しい会話を始めない。walltime で合成の途中に殺されると、
#      書きかけの wav が次の回で完成品として飛ばされるため
#
# ## 担当
#
# wiki_qa_015000〜064312 の 49,313 件（$B/synth_abci_in に symlink で置いた）。
# それより前（JaQuAD の残りと wiki_qa_000000〜014999）は研究室サーバが作る。
#
# 既に wav がある会話は飛ばすので、同じコマンドで投げ直せば続きから進む。
# 投げ直すときは 6 本すべて同じ NSHARD で投げること（担当がずれると同じ会話を 2 本が作る）。
# synth_abci_in の中身を変えるのは、6 本がすべて終わってから（途中で変えると担当がずれる）。
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=12:00:00
#PBS -N 0374_synth
#PBS -j oe
#PBS -o logs/

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/12.6 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"

# 外部に出ない設定
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export HTTP_PROXY=http://127.0.0.1:9 HTTPS_PROXY=http://127.0.0.1:9
export http_proxy=$HTTP_PROXY https_proxy=$HTTPS_PROXY
export NO_PROXY="" no_proxy=""
export AUDIT_NET=1

# アレイジョブの添字は ABCI では 1 始まりしか許されない（-J 1-6）。1 を引いてシャード番号にする
if [ -n "${PBS_ARRAY_INDEX:-}" ]; then SHARD=$((PBS_ARRAY_INDEX - 1)); else SHARD="${SHARD:-0}"; fi
NSHARD="${NSHARD:-6}"
B=/groups/gcg51557/experiments/0374_japanese_kame
TTS=$B/tts/zoom1-tts
PY=$TTS/.venv/bin/python
W=$PWD/tools/synth_worker.py
IN=$B/synth_abci_in
OUT=$B/wiki_audio
mkdir -p "$OUT"

echo "===== $(date) $(hostname) shard=$SHARD/$NSHARD ====="
git rev-parse --short HEAD
nvidia-smi --query-gpu=name --format=csv,noheader
echo "担当全体 $(find $IN -maxdepth 1 -name '*.txt' | wc -l) 件 / 開始時点の wav $(find $OUT -maxdepth 1 -name '*.wav' | wc -l) 件"

# GPU の使用率を 1 分ごとに記録する。削除の原因の仮説（GPU を確保しているのに使用率が低い）を
# 確かめる材料。.o ファイルはジョブの終了まで見えないので、別のファイルに書く
mkdir -p "$B/synth_gpu_log"
GLOG="$B/synth_gpu_log/${PBS_JOBID%%.*}_shard${SHARD}.csv"
nvidia-smi --query-gpu=timestamp,utilization.gpu,memory.used --format=csv,noheader -l 60 \
    > "$GLOG" 2>&1 &
GPID=$!
echo "GPU の記録: $GLOG"

cd "$TTS"
"$PY" "$W" --in_dir "$IN" --out_dir "$OUT" --shard "$SHARD" --nshard "$NSHARD" \
    --max_seconds 41400
RC=$?
kill "$GPID" 2>/dev/null

echo "===== 終了 $(date) / 終了コード $RC ====="
echo "終了時点の wav $(find $OUT -maxdepth 1 -name '*.wav' | wc -l) 件"
