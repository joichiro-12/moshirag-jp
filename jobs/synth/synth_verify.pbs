#!/bin/bash
# 音声化の高速化が成立するかを確かめる。
#
# 確かめることは 2 つ。
#   ① モデルを使い回しても出力が変わらないか
#   ② モデル読み込みが 100 秒/会話のうちどれだけを占めるか
#
# ①は既存 wav とのハッシュ比較では判定できない。GPU 演算は完全には決定的でなく、
# TTS は温度 0.9 でサンプリングするため、微小な数値差が別の音声を生みうる。
# そこで**同一プロセス内で同じ会話を 2 回合成**し、「連続」と「間に別の会話を挟む」を比べる。
#
# ②は 1 回目（読み込み直後）と 2 回目以降の所要の差から出す。
#
# 本番ディレクトリには書かない（_verify/ 以下にだけ書く）。
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -N 0374_synth_verify
#PBS -j oe
#PBS -o logs/

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/12.6 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"
export PATH="$HOME/.local/bin:$PATH"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false

B=/groups/gcg51557/experiments/0374_japanese_kame
TTS=$B/tts/zoom1-tts
W=$PWD/moshirag_data/speech_dialogue/s04_synth.py

echo "===== $(date) $(hostname) ====="
git rev-parse --short HEAD; git status --porcelain | grep -v '^??' | wc -l

cd "$TTS"
uv run python "$W" \
    --in_dir $B/pilot5k_in --out_dir $B/pilot5k_audio \
    --nshard 1 --shard 0 --verify 4
