#!/bin/bash
# 音声化の試験（1 GPU・20 会話）。管理者に 2 回削除された原因を切り分ける。
#
#   qsub -P gcg51557 jobs/synth/synth_test.pbs
#
# ## 何を確かめるか
#
# 9/20 のジョブは HF_HUB_OFFLINE=1 が無く、huggingface_hub が外部（huggingface.co）へ
# 接続を試みていたことが分かっている。9/26 のジョブは設定済みだったが、それでも削除された。
# 見落としている外部接続があるかを、次の 2 つで確かめる。
#
#   ① 繋がらない代理サーバ（127.0.0.1:9）を設定する。HTTP(S) の接続はノードの外に出る前に
#      即座に失敗する。huggingface_hub は代理サーバの失敗を黙らずに例外として投げる
#   ② AUDIT_NET=1 で、名前の問い合わせと接続の宛先をすべてログに書く
#
# ## 結果の読み方
#
#   最後まで走り、消されない、外部接続 0 件  → 直した設定なら通る。本数を少しずつ増やす
#   外部接続が記録される／代理サーバで落ちる  → 見落としていた接続がある。塞ぐ
#   外部接続 0 件なのに消される               → 外部接続以外が原因。これ以上は再投入しない
#
# ジョブ名は偽らない（同種のジョブが名前で狙われているなら、それも分かる情報になる）。
# 出力は本番のディレクトリに書く（worker 方式は検証済みで、できた音声はそのまま使える）。
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -N 0374_synth_test
#PBS -j oe

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/12.6 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"

# 外部に出ない設定
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export HTTP_PROXY=http://127.0.0.1:9 HTTPS_PROXY=http://127.0.0.1:9
export http_proxy=$HTTP_PROXY https_proxy=$HTTPS_PROXY
export NO_PROXY="" no_proxy=""
export AUDIT_NET=1

B=/groups/gcg51557/experiments/0374_japanese_kame
TTS=$B/tts/zoom1-tts
PY=$TTS/.venv/bin/python
W=$PWD/tools/synth_worker.py

echo "===== $(date) $(hostname) ====="
git rev-parse --short HEAD; git status --porcelain | grep -v '^??' | wc -l
echo "HF_HUB_OFFLINE=$HF_HUB_OFFLINE / HTTPS_PROXY=$HTTPS_PROXY / AUDIT_NET=$AUDIT_NET"
echo "開始時点の wav: $(find $B/pilot5k_audio -maxdepth 1 -name '*.wav' | wc -l)"

cd "$TTS"
S=$(date +%s)
"$PY" "$W" --in_dir $B/pilot5k_in --out_dir $B/pilot5k_audio \
    --shard 0 --nshard 1 --limit 20
RC=$?
E=$(date +%s)

echo "===== 終了 $(date) ====="
echo "終了コード $RC / 経過 $((E-S)) 秒"
echo "終了時点の wav: $(find $B/pilot5k_audio -maxdepth 1 -name '*.wav' | wc -l)"
