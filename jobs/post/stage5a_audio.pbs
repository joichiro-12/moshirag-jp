#!/bin/bash
# 工程 5a：会話 wav を Mimi トークンに変換する。
#PBS -P gcg51557
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=6:00:00
#PBS -N 0374_s5a
#PBS -j oe
#PBS -o logs/
set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
export PATH="$HOME/.local/bin:$PATH"
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/12.6 2>/dev/null || true
B=/groups/gcg51557/experiments/0374_japanese_kame
uv run --extra data -m tools.tokenize_audio \
  --audio_dir  $B/stage5_audio \
  --output_dir $B/stage5_tokenized_audio \
  --num_workers 8
