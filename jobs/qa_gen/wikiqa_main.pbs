#!/bin/bash
# Wikipedia の記事から問いと答えの組を作る（本番 20 万件）。
#
#   for s in $(seq 0 7); do qsub -P gcg51557 -v SHARD=$s,NSHARD=8 jobs/qa_gen/wikiqa_main.pbs; done
#
# 規模の根拠：JaQuAD の 35,687 トピックの 5.6 倍。4 スタイルに広げれば 80 万会話になり、
# 当面の音声化能力（36 会話/時/GPU）を大きく超えるため、これ以上は先に作っても使えない。
# 候補は 740,916 件あるので、必要になれば --num_samples を上げるだけで増やせる
# （シャッフルは乱数種のみに依存するため、既存分はそのまま活きる）。
#
# 実測スループットは 26,866 件/時（1 GPU、32 並列）。8 分割で 1 シャード約 1 時間。
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=04:00:00
#PBS -N 0374_wikiqa
#PBS -j oe

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
mkdir -p logs   # vLLM のサーバのログの置き場（git の管理外）
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/13.0 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"

SHARD="${SHARD:-0}"; NSHARD="${NSHARD:-1}"
PORT=$((8200 + SHARD))
TAG="s${SHARD}of${NSHARD}"

export VLLM_USE_FLASHINFER_SAMPLER=0 HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_CACHE_ROOT=/tmp/vllm_cache_${USER}_wq_${TAG}
export TORCHINDUCTOR_CACHE_DIR=/tmp/inductor_${USER}_wq_${TAG}
export TRITON_CACHE_DIR=/tmp/triton_${USER}_wq_${TAG}
mkdir -p "$VLLM_CACHE_ROOT" "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"

MODEL=/groups/gcg51557/experiments/0374_japanese_kame/models/llm-jp-4-32b-a3b-thinking
VENV=.venv_vllm; NAME=llm-jp-4-32b-a3b-thinking
IN=data/japanese_kame/qa_pairs/wiki_candidates.jsonl
OUT=data/japanese_kame/qa_pairs/wiki_qa.jsonl
TOTAL=200000

echo "===== $(date) $(hostname) シャード ${SHARD}/${NSHARD} ====="
git rev-parse --short HEAD; git status --porcelain | wc -l

$VENV/bin/python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL" --served-model-name "$NAME" \
    --max-model-len 16384 --gpu-memory-utilization 0.90 --enforce-eager \
    --port "$PORT" > "logs/vllm_server_wq_${TAG}.log" 2>&1 &
VLLM_PID=$!
trap 'kill "$VLLM_PID" 2>/dev/null || true' EXIT

for i in $(seq 1 150); do
    curl -s -o /dev/null "http://localhost:${PORT}/v1/models" && { echo "vLLM ready ($((i*10))s)"; break; }
    kill -0 "$VLLM_PID" 2>/dev/null || { echo "!! vLLM died"; tail -40 "logs/vllm_server_wq_${TAG}.log"; exit 1; }
    sleep 10
done

S=$(date +%s)
$VENV/bin/python scripts/japanese_kame/01c_generate_wiki_qa.py \
    --input_file "$IN" --output_file "$OUT" \
    --num_samples $TOTAL --seed 1 --shard "$SHARD" --nshard "$NSHARD" \
    --workers 32 --effort low --role default \
    --model "$NAME" --llm_base_url "http://localhost:${PORT}/v1"
E=$(date +%s)

echo "===== 終了 $(date) ====="
echo "経過 $((E-S)) 秒"
echo "全シャードの合計: $(cat data/japanese_kame/qa_pairs/wiki_qa.s*.jsonl 2>/dev/null | wc -l) 件"
