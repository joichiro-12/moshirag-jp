#!/bin/bash
# 段 1：JaQuAD 全量 35,687 会話の生成。既存 5,000 件は --resume で飛ばす。
#
#   for s in $(seq 0 15); do qsub -P gcg51557 -v SHARD=$s,NSHARD=16 jobs/qa_gen/gen_stage1.pbs; done
#
# --seed 1 は既存分と同一。シャッフルは seed のみに依存するため --num_samples を
# 5000 → 35687 に上げても先頭 5,000 件の添字と内容は変わらない（verify_sampling.py で
# 5,000 件全数照合し不一致 0 を確認済み）。
# シャード分割は添字 i を分割前のまま保つので、分割の有無で生成結果は変わらない。
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=12:00:00
#PBS -N 0374_gen_s1
#PBS -j oe
#PBS -o logs/

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
mkdir -p logs   # vLLM のサーバのログの置き場（git の管理外）
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/13.0 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"

SHARD="${SHARD:-0}"; NSHARD="${NSHARD:-1}"
# 同一ノードに複数の rt_HG ジョブが載ってもぶつからないよう、ポートと一時領域を分ける
PORT=$((8000 + SHARD))
TAG="s${SHARD}of${NSHARD}"

export VLLM_USE_FLASHINFER_SAMPLER=0 HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_CACHE_ROOT=/tmp/vllm_cache_${USER}_${TAG}
export TORCHINDUCTOR_CACHE_DIR=/tmp/inductor_${USER}_${TAG}
export TRITON_CACHE_DIR=/tmp/triton_${USER}_${TAG}
mkdir -p "$VLLM_CACHE_ROOT" "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"

MODEL=/groups/gcg51557/experiments/0374_japanese_kame/models/llm-jp-4-32b-a3b-thinking
VENV=.venv_vllm; NAME=llm-jp-4-32b-a3b-thinking
SCRIPT=moshirag_data/s02_dialogue.py
OUT=data/moshirag_jp/pilot5k      # 既存 5,000 件と同じ場所。--resume が効くよう変えない
TOTAL=35687

echo "===== $(date) $(hostname) シャード ${SHARD}/${NSHARD} ====="
git rev-parse --short HEAD; git status --porcelain | wc -l
echo "開始時点の完了数: $(ls "$OUT"/*.json 2>/dev/null | wc -l) / $TOTAL"

$VENV/bin/python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL" --served-model-name "$NAME" \
    --max-model-len 16384 --gpu-memory-utilization 0.90 --enforce-eager \
    --port "$PORT" > "logs/vllm_server_${TAG}.log" 2>&1 &
VLLM_PID=$!
trap 'kill "$VLLM_PID" 2>/dev/null || true' EXIT

for i in $(seq 1 150); do
    curl -s -o /dev/null "http://localhost:${PORT}/v1/models" && { echo "vLLM ready ($((i*10))s)"; break; }
    kill -0 "$VLLM_PID" 2>/dev/null || { echo "!! vLLM died"; tail -40 "logs/vllm_server_${TAG}.log"; exit 1; }
    sleep 10
done

S=$(date +%s)
$VENV/bin/python "$SCRIPT" \
    --input_file data/japanese_kame/qa_pairs/jaquad.jsonl \
    --output_dir "$OUT" --num_samples $TOTAL --seed 1 \
    --shard "$SHARD" --nshard "$NSHARD" \
    --model "$NAME" --llm_base_url "http://localhost:${PORT}/v1" \
    --min_turns 3 --max_turns 5 --workers 32 \
    --effort_human high --effort_assistant low --effort_chunk low \
    --effort_judge low --effort_lead low --resume 2>&1 | tail -20
E=$(date +%s)

N=$(ls "$OUT"/*.json 2>/dev/null | wc -l)
echo "===== 終了 $(date) ====="
echo "経過 $((E-S)) 秒 / 全体の完了数 $N / $TOTAL"
