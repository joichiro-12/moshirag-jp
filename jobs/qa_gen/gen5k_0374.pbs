#!/bin/bash
# MoshiRAG-JP パイロット生成 5,000 会話（workers=32、12h 区切り、--resume で継続）
# 同一 --seed / --num_samples なので、何度投げても同じ 5,000 トピックを対象に
# 未完了分だけを埋める。キューを長時間占有しないため 12h で区切る。
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=04:00:00
#PBS -N 0374_moshirag_5k
#PBS -j oe

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
mkdir -p logs   # vLLM のサーバのログの置き場（git の管理外）
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/13.0 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"
export VLLM_USE_FLASHINFER_SAMPLER=0 HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_CACHE_ROOT=/tmp/vllm_cache_$USER TORCHINDUCTOR_CACHE_DIR=/tmp/inductor_$USER TRITON_CACHE_DIR=/tmp/triton_$USER
mkdir -p "$VLLM_CACHE_ROOT" "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"

MODEL=/groups/gcg51557/experiments/0374_japanese_kame/models/llm-jp-4-32b-a3b-thinking
VENV=.venv_vllm; PORT=8000; NAME=llm-jp-4-32b-a3b-thinking
SCRIPT=scripts/japanese_kame/02e_generate_moshirag_v5.py
OUT=data/moshirag_jp/pilot5k

echo "===== $(date) $(hostname) ====="
git rev-parse --short HEAD; git status --porcelain | wc -l
echo "開始時点の完了数: $(ls "$OUT"/*.txt 2>/dev/null | wc -l) / 5000"

$VENV/bin/python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL" --served-model-name "$NAME" \
    --max-model-len 16384 --gpu-memory-utilization 0.90 --enforce-eager \
    --port "$PORT" > logs/vllm_server.log 2>&1 &
VLLM_PID=$!
trap 'kill "$VLLM_PID" 2>/dev/null || true' EXIT

for i in $(seq 1 150); do
    curl -s -o /dev/null "http://localhost:${PORT}/v1/models" && { echo "vLLM ready ($((i*10))s)"; break; }
    kill -0 "$VLLM_PID" 2>/dev/null || { echo "!! vLLM died"; tail -40 logs/vllm_server.log; exit 1; }
    sleep 10
done

S=$(date +%s)
$VENV/bin/python "$SCRIPT" \
    --input_file data/japanese_kame/qa_pairs/jaquad.jsonl \
    --output_dir "$OUT" --num_samples 5000 --seed 1 \
    --model "$NAME" --llm_base_url "http://localhost:${PORT}/v1" \
    --min_turns 3 --max_turns 5 --workers 32 \
    --effort_human high --effort_assistant low --effort_chunk low \
    --effort_judge low --effort_lead low --resume 2>&1 | tail -20
E=$(date +%s)

N=$(ls "$OUT"/*.txt 2>/dev/null | wc -l)
echo "===== 終了 $(date) ====="
echo "完了数: ${N} / 5000   このジョブの経過: $((E-S))s"
echo "残り: $((5000-N)) 会話"
