#!/bin/bash
# 音声化の本番。rt_HF の 1 ノード（8 GPU）で 8 シャードを並列に処理する。
#
#   for n in 0 1 2 3; do qsub -P gcg51557 -v NODE=$n,NNODE=4,MODE=cli synth_node.pbs; done
#
# ## 方式（MODE）
#
#   cli    : 会話ごとに TTS の CLI を起動する（既存の synth_shard.pbs と同じ処理）。
#            5,191 件を作った実績があり、安全性が分かっている
#   worker : synth_worker.py がモデルを 1 回だけ読み込んで担当分を処理する。
#            **synth_verify.pbs で使い回しが安全と確認できてから使う**
#
# どちらも既に .wav がある会話は飛ばすので、途中で方式を切り替えても壊れない。
#
# ## なぜ rt_HF か
#
# rt_HG × 32 ジョブは 9/20 に一斉停止し、キューも待機 852 件と混んでいる。
# rt_HF に 8 シャードずつ詰めれば、GPU 数 32 のままジョブ数が 4 になる。
#
# 1 ノードで 8 プロセスが同時に走るため、`uv run` のキャッシュロックの競合を避けて
# TTS の venv の python を直接呼ぶ。
#PBS -P gcg51557
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=48:00:00
#PBS -N 0374_synth_node
#PBS -j oe

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
source /etc/profile.d/modules.sh 2>/dev/null || true
module load cuda/12.6 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
# 外部に出ない保険（9/27 追加）。9/20 の削除は huggingface_hub の外部接続の試みが原因の
# 可能性が高い。HTTP(S) は繋がらない代理サーバに向けてノードの外に出る前に失敗させ、
# 接続先の監査（AUDIT_NET=1）で試みがあれば記録する。試験ジョブ 2450505 で外部接続 0 件を確認済み
export HTTP_PROXY=http://127.0.0.1:9 HTTPS_PROXY=http://127.0.0.1:9
export http_proxy=$HTTP_PROXY https_proxy=$HTTPS_PROXY
export NO_PROXY="" no_proxy=""
export AUDIT_NET=1

NODE="${NODE:-0}"; NNODE="${NNODE:-1}"; MODE="${MODE:-cli}"
GPUS=8
NSHARD=$((NNODE * GPUS))
B=/groups/gcg51557/experiments/0374_japanese_kame
IN_DIR="${IN_DIR:-$B/pilot5k_in}"
OUT_DIR="${OUT_DIR:-$B/pilot5k_audio}"
TTS=$B/tts/zoom1-tts
PY=$TTS/.venv/bin/python
W=$PWD/tools/synth_worker.py
LOGD=$PWD/logs/synth_node_${PBS_JOBID:-local}
mkdir -p "$LOGD"

echo "===== $(date) $(hostname) ノード ${NODE}/${NNODE}（シャード総数 ${NSHARD}、方式 ${MODE}）====="
git rev-parse --short HEAD; git status --porcelain | grep -v '^??' | wc -l
echo "入力 $IN_DIR / 出力 $OUT_DIR"
echo "開始時点の wav: $(find "$OUT_DIR" -maxdepth 1 -name '*.wav' | wc -l)"

# 1 シャードぶんを CLI 方式で処理する（synth_shard.pbs と同じループ）
cli_shard() {
    local SHARD=$1 n=0 skip=0 i=0 S
    S=$(date +%s)
    for f in "$IN_DIR"/*.txt; do
        i=$((i + 1))
        [ $(( (i - 1) % NSHARD )) -eq "$SHARD" ] || continue
        local stem; stem=$(basename "$f" .txt)
        [ -s "$OUT_DIR/${stem}.wav" ] && { skip=$((skip + 1)); continue; }
        "$PY" -m zoom1_dialogue_tts.cli "$f" -o "$OUT_DIR/${stem}.wav" \
            --variant drop --turn-timing stat --backchannels stat --seed 0 --max-turn-ms 45000 \
            > "$OUT_DIR/${stem}.log" 2>&1 && n=$((n + 1)) || echo "  失敗: $stem"
        if [ $((n % 25)) -eq 0 ] && [ "$n" -gt 0 ]; then
            echo "  $n 件 / $(( $(date +%s) - S ))s（$(awk "BEGIN{printf \"%.1f\", ($(date +%s)-$S)/$n}") 秒/会話）"
        fi
    done
    echo "合成 $n 件 / スキップ $skip 件 / $(( $(date +%s) - S )) 秒"
}

cd "$TTS"
S=$(date +%s)
for g in $(seq 0 $((GPUS - 1))); do
    SHARD=$((NODE * GPUS + g))
    if [ "$MODE" = worker ]; then
        CUDA_VISIBLE_DEVICES=$g "$PY" "$W" \
            --in_dir "$IN_DIR" --out_dir "$OUT_DIR" --shard "$SHARD" --nshard "$NSHARD" \
            > "$LOGD/shard${SHARD}.log" 2>&1 &
    else
        CUDA_VISIBLE_DEVICES=$g cli_shard "$SHARD" > "$LOGD/shard${SHARD}.log" 2>&1 &
    fi
    echo "  GPU $g → シャード $SHARD（pid $!）"
done
wait
E=$(date +%s)

echo "===== 終了 $(date) ====="
echo "経過 $((E - S)) 秒"
echo "終了時点の wav: $(find "$OUT_DIR" -maxdepth 1 -name '*.wav' | wc -l)"
for g in $(seq 0 $((GPUS - 1))); do
    SHARD=$((NODE * GPUS + g))
    echo "--- シャード $SHARD ---"
    grep -E "合成 |秒/会話|読み込み回数|外部接続の試み:" "$LOGD/shard${SHARD}.log" | tail -4
done
