#!/bin/bash
# MoshiRAG-JP conversation script generation (smoke test).
#   qsub gen_0374_moshirag.pbs
# Serves llm-jp-4-32b-a3b-thinking on one H200 (rt_HG) and runs
# scripts/japanese_kame/02c_generate_moshirag_v2.py against it.
#PBS -P gcg51557
#PBS -q rt_HG
#PBS -l select=1
#PBS -l walltime=02:00:00
#PBS -N 0374_moshirag_v4
#PBS -j oe

set -u
cd "${PBS_O_WORKDIR:-$(pwd)}"
source /etc/profile.d/modules.sh 2>/dev/null || true
# torch here is 2.13.0+cu130, so load a matching CUDA toolkit. Without CUDA_HOME the
# FlashInfer sampler tries to JIT-compile and dies with
#   "Could not find nvcc and default cuda_home='/usr/local/cuda' doesn't exist"
module load cuda/13.0 2>/dev/null || module load cuda/12.8 2>/dev/null || true
export CUDA_HOME="${CUDA_HOME:-${CUDA_PATH:-}}"
# Belt and braces: use the Torch-native sampler so no runtime nvcc is needed at all.
export VLLM_USE_FLASHINFER_SAMPLER=0

MODEL=/groups/gcg51557/experiments/0374_japanese_kame/models/llm-jp-4-32b-a3b-thinking
VENV=.venv_vllm
PORT=8000
NAME=llm-jp-4-32b-a3b-thinking
OUT=data/moshirag_jp/v4_pilot

export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
# Run the engine in-process: the v1 multiprocessing engine core died silently on rt_HG.
export VLLM_ENABLE_V1_MULTIPROCESSING=0
# Keep compile / inductor caches on node-local disk (Lustre breaks them).
export VLLM_CACHE_ROOT=/tmp/vllm_cache_$USER
export TORCHINDUCTOR_CACHE_DIR=/tmp/inductor_$USER
export TRITON_CACHE_DIR=/tmp/triton_$USER
mkdir -p "$VLLM_CACHE_ROOT" "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"

echo "===== diagnostics ====="
date; hostname
echo "--- /dev/shm ---"; df -h /dev/shm
echo "--- tmp ---"; df -h /tmp | tail -1
echo "--- ulimit ---"; ulimit -a | grep -Ei 'memory|files|processes|stack'
echo "--- cpus ---"; nproc
echo "--- cuda ---"; echo "CUDA_HOME=$CUDA_HOME"; which nvcc || echo "nvcc: not found"
echo "--- gpu ---"; nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv
$VENV/bin/python -c "import torch, vllm; print('torch', torch.__version__, 'cuda', torch.version.cuda, 'avail', torch.cuda.is_available(), 'ndev', torch.cuda.device_count()); print('vllm', vllm.__version__)"

echo "===== start vLLM ====="
$VENV/bin/python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL" \
    --served-model-name "$NAME" \
    --max-model-len 16384 \
    --gpu-memory-utilization 0.90 \
    --enforce-eager \
    --port "$PORT" \
    > vllm_server.log 2>&1 &
VLLM_PID=$!

cleanup() { echo "killing vLLM ($VLLM_PID)"; kill "$VLLM_PID" 2>/dev/null || true; }
trap cleanup EXIT

echo "===== wait for readiness (max 25 min) ====="
READY=0
for i in $(seq 1 150); do
    if curl -s -o /dev/null "http://localhost:${PORT}/v1/models"; then
        echo "vLLM ready after $((i * 10))s"; READY=1; break
    fi
    if ! kill -0 "$VLLM_PID" 2>/dev/null; then
        echo "!! vLLM died during startup — full server log follows"
        echo "================ vllm_server.log ================"
        cat vllm_server.log
        exit 1
    fi
    sleep 10
done
if [ "$READY" -eq 0 ]; then
    echo "!! vLLM did not become ready in time"; tail -100 vllm_server.log; exit 1
fi
curl -s "http://localhost:${PORT}/v1/models"; echo

echo "===== single-call smoke test ====="
curl -s "http://localhost:${PORT}/v1/chat/completions" \
    -H 'Content-Type: application/json' \
    -d "{\"model\":\"$NAME\",\"messages\":[{\"role\":\"user\",\"content\":\"こんにちはと一言だけ返してください。\"}],\"max_tokens\":64}" \
    | head -c 1500; echo

echo "===== generate (20 conversations) ====="
time $VENV/bin/python scripts/japanese_kame/02c_generate_moshirag_v2.py \
    --input_file data/japanese_kame/qa_pairs/jaquad.jsonl \
    --output_dir "$OUT" \
    --num_samples 20 \
    --model "$NAME" \
    --llm_base_url "http://localhost:${PORT}/v1" \
    --min_turns 3 --max_turns 5 --workers 8 \
    --effort_human high --effort_assistant low --effort_chunk low --effort_judge low --effort_lead low \
    --resume

echo "===== results ====="
ls -la "$OUT" 2>/dev/null | head -20
echo "--- sample record ---"
head -40 "$(ls "$OUT"/*.txt 2>/dev/null | head -1)" 2>/dev/null || echo "(no output)"
echo "===== vLLM server log tail ====="
tail -25 vllm_server.log
date
